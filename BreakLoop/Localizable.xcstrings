          "stringUnit": {
            "state": "translated",
            "value": "Toplam %lld dakika kullanımdan sonra seçilen uygulamalar %lld dakika engellenir. Değişiklikler bir sonraki döngüde uygulanır."
          }
        }
      }
    },

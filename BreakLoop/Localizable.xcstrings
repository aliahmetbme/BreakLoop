    "A repeating cycle of shared app usage and rest, rather than a daily limit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A repeating cycle of shared app usage and rest, rather than a daily limit."

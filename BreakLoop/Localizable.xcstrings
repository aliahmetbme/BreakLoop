    "Focus when you choose. Pause when you need.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus when you choose. Pause when you need."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğinde odaklan. Gerektiğinde mola ver."
          }
        }
      }
    },
    "Give selected apps and categories one shared usage allowance. Their usage adds up together.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give selected apps and categories one shared usage allowance. Their usage adds up together."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin uygulama ve kategorilere ortak bir kullanım süresi belirle. Kullanım süreleri birlikte hesaplanır."
          }
        }
      }
    },
    "Cooldown & Natural Rest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cooldown & Natural Rest"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik Mola ve Doğal Mola"
          }
        }
      }
    },
    "When your shared allowance runs out, selected apps pause for your chosen break. Time away may also count toward an estimated natural rest.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your shared allowance runs out, selected apps pause for your chosen break. Time away may also count toward an estimated natural rest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak kullanım süren dolduğunda seçtiğin uygulamalar molaya girer. Kullanımdan uzak kaldığın süre, Doğal Mola kapsamında da tahmin edilebilir."
          }
        }
      }
    },
    "Start a fixed focus session when you want selected apps paused right away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a fixed focus session when you want selected apps paused right away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin uygulamalara hemen ara vermek istediğinde belirli süreli bir odak oturumu başlat."
          }
        }
      }
    },
    "Choose the apps you want to take a break from.": {

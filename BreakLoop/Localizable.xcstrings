                      "state": "translated",
                      "value": "%arg minute"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg minutes"
                    }
                  }
                }
              }
            },
            "arg2": {
              "argNum": 2,
